# Public origin of the site. No trailing slash.
NEXT_PUBLIC_SITE_URL="https://callaz.dk"

# Transactional mail for the enquiry form (https://resend.com).
# With no key set, submissions are logged to the server console instead —
# handy locally, and it keeps the form usable before the domain is verified.
RESEND_API_KEY=""

# Verified sender on the Resend domain, e.g. "Callaz <no-reply@callaz.dk>".
ENQUIRY_FROM=""

# Inbox that receives enquiries. Falls back to the address in src/content/company.ts.
ENQUIRY_TO=""
