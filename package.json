{
  "name": "callaz",
  "private": true,
  "description": "Callaz — international contact centre. Next.js, TypeScript and Tailwind CSS.",
  "license": "UNLICENSED",
  "version": "1.0.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "check:messages": "node scripts/check-messages.mjs",
    "verify": "npm run typecheck && npm run lint && npm run check:messages"
  },
  "dependencies": {
    "next": "^16.3.4",
    "next-intl": "^4.13.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^20.19.11",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.3.4",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.2"
  }
}
